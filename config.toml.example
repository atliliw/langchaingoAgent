[server]
host = "0.0.0.0"
port = 8090
upload_dir = "uploads"

[openai]
api_key = "your-api-key"
base_url = "https://api.openai.com/v1"
chat_model = "gpt-3.5-turbo"
embedding_model = "text-embedding-ada-002"

[embedding]
api_key = ""
base_url = ""
model = "text-embedding-3-small"

[qdrant]
url = "http://localhost:6334"
collection_name = "demo_documents"
vector_size = 1536
distance = "Cosine"

[mongodb]
uri = "mongodb://localhost:27017"
database = "langchainrust_demo"
parent_collection = "bm25_parents"
chunk_collection = "bm25_chunks"

[sqlite]
db_path = "conversations.db"

[document]
chunk_size = 500
chunk_overlap = 50
supported_types = ["txt", "pdf", "md", "json", "csv"]

[search]
default_top_k = 5
min_score = 0.5
test_sample_count = 10

[logging]
level = "info"
file_output = false
log_file = "logs/demo.log"

[conversation]
max_history_messages = 50
max_tokens = 4000
keep_first_n_messages = 2
compress_threshold = 15
keep_recent_messages = 5
important_keywords = ["我的名字", "我是", "记住", "设定", "角色"]
summary_model = "gpt-3.5-turbo"
